# End-to-end stack (`make e2e`): a throwaway Compose project (slax-e2e) with its own
# volumes, nothing published on the host. Read by Compose for interpolation (--env-file)
# and by the Laravel services (env_file). Nothing here is a secret: every value only
# works inside this local stack, and APP_KEY is generated by `make e2e` on each run.

APP_NAME=Slax
APP_ENV=e2e
APP_DEBUG=true
# The browser (Playwright) shares the web container's network: the app is http://localhost.
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=slax_e2e
DB_USERNAME=slax
DB_PASSWORD=slax-e2e-only

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=slax-e2e
REVERB_APP_KEY=slax-e2e-key
REVERB_APP_SECRET=slax-e2e-only
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_MAX_REQUEST_SIZE=131072

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=slaxminio
AWS_SECRET_ACCESS_KEY=slaxminio-e2e-only
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=slax-files
AWS_ENDPOINT=http://minio:9000
AWS_PUBLIC_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SCANNER_URL=http://scanner:8000

# Google is never called: APP_ENV=e2e binds the stand-in provider (E2eIdentityProvider).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
ADMIN_EMAILS=

# Cloudflare's published always-pass TEST keys (public, not secrets). The browser gets a
# stub widget that checks it was given this site key; the backend fakes the verification.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

SANCTUM_STATEFUL_DOMAINS=localhost
