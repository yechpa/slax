# Slax local development configuration.
# `make env` copies this to .env (git-ignored) and generates APP_KEY.
# Everything below is a placeholder for the local Docker stack only:
# real secrets never go in this repository.

APP_NAME=Slax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
WEB_PORT=8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=slax
DB_USERNAME=slax
DB_PASSWORD=slax-local-dev

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DRIVER=redis
# Minutes a session lasts without a request, rolling (14 days, as in the chart's
# session.lifetimeMinutes). Sign-out and a ban end a session at once.
SESSION_LIFETIME=20160
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Laravel Reverb (WebSocket). The app publishes to reverb:8080 directly;
# browsers connect through the web proxy (same origin, path /app).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=slax-local
REVERB_APP_KEY=slax-local-key
REVERB_APP_SECRET=slax-local-dev
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Largest HTTP request Reverb accepts from the app (bytes). The Pusher SDK JSON-encodes
# payloads twice: a 4000-character emoji message is ~57 KB, ~67 KB with its reactions.
REVERB_MAX_REQUEST_SIZE=131072

# Object storage (MinIO locally, S3 elsewhere).
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=slaxminio
AWS_SECRET_ACCESS_KEY=slaxminio-local-dev
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=slax-files
AWS_ENDPOINT=http://minio:9000
# Where browsers fetch files (presigned download URLs); MinIO is published on localhost:9000.
AWS_PUBLIC_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Upload validation service (compose network only, no published port).
SCANNER_URL=http://scanner:8000

# Google sign-in (OpenID Connect). Create an OAuth "Web application" client in
# Google Cloud Console and put its values in your local .env (never commit them).
# The redirect URI must be registered for each environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Administrators: comma-separated Google addresses.
ADMIN_EMAILS=

# Administrator alerts through a Telegram bot. Both are secrets: leave them empty here and
# set them only in your local .env or in the deployment's secrets (never in the repository).
# Empty: alerts are simply not sent. SLAX_ENV_LABEL prefixes every alert ("[Dev]" by
# default; production sets Prod).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLAX_ENV_LABEL=Dev

# Web Push notifications (VAPID). Empty: push is off and the app hides its switch (the local
# stack needs no keys). To try it locally, paste the two lines `make shell` then
# `php artisan slax:push-keys` prints. Never commit a pair; deployments keep theirs in the
# Kubernetes Secret (deploy/dev/create-secrets.sh). VAPID_SUBJECT: mailto: or https: (empty:
# APP_URL when it is https).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# The nightly demo reset (slax:demo-reset) deletes visitors' accounts and content. Only the
# public showcase turns it on; leave it false everywhere else (`make up` still seeds the demo).
SLAX_DEMO_RESET_ENABLED=false

# Days the audit log keeps its entries (audit:prune, daily).
SLAX_AUDIT_RETENTION_DAYS=180

# Production only: the database backups bucket. backups:check-freshness (daily) alerts when
# its newest dump is older than 30 hours. Empty here: nothing is checked.
SLAX_BACKUP_BUCKET=

# Cloudflare Turnstile. These are Cloudflare's published always-pass TEST keys
# (public, not secrets). Use real keys in production. The site key also goes to
# the browser (VITE_TURNSTILE_SITE_KEY, see the frontend service), as does
# REVERB_APP_KEY (VITE_REVERB_APP_KEY).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Browser origins whose API calls use the session cookie (Sanctum): host:port exactly as the
# browser sends it, so change it with WEB_PORT. Any other origin gets no session and sign-in
# answers 400 session_unavailable. (The tests pin their own value in backend/phpunit.xml.)
SANCTUM_STATEFUL_DOMAINS=localhost:8080
